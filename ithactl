#!/usr/bin/env bash
# ithactl - symlink manager for the dotfiles in this repo.
# Reads links.conf (name | src | dst | os). Works with macOS's bash 3.2.
set -u

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
MANIFEST="$REPO/links.conf"
OS="$(uname -s | tr '[:upper:]' '[:lower:]')"
TS="$(date +%Y%m%d-%H%M%S)"

if [[ -t 1 ]]; then
	G=$'\e[32m' R=$'\e[31m' Y=$'\e[33m' D=$'\e[2m' N=$'\e[0m'
else
	G= R= Y= D= N=
fi

die() { printf '%s\n' "${R}error:${N} $*" >&2; exit 1; }
info() { printf '%s\n' "$*"; }

usage() {
	cat <<USAGE
ithactl - manage the symlinks for this repo's configs

Usage:
  ithactl list|ls [-q]               status of every config (-q: only problems)
  ithactl apply|ap [NAME...] [opts]  link configs (default: all for this OS)
  ithactl remove|rm [NAME...] [-y]   remove symlinks that point into this repo
  ithactl adopt NAME                 move the existing file/dir into the repo, then link it
  ithactl help

apply options:
  -b, --backup      move an existing file aside (NAME.backup-<timestamp>)
  -w, --overwrite   delete an existing file
  -n, --dry-run     show what would happen
  (default: leave existing files alone and report them)

Manifest: $MANIFEST
USAGE
}

# --- manifest ---------------------------------------------------------------
NAMES=() SRCS=() DSTS=() OSES=()
load_manifest() {
	[[ -f "$MANIFEST" ]] || die "manifest not found: $MANIFEST"
	local line n s d o
	while IFS= read -r line || [[ -n "$line" ]]; do
		line="${line%%#*}"
		[[ "$line" =~ ^[[:space:]]*$ ]] && continue
		IFS='|' read -r n s d o <<<"$line"
		n="$(trim "$n")" s="$(trim "$s")" d="$(trim "$d")" o="$(trim "${o:-any}")"
		[[ -n "$n" && -n "$s" && -n "$d" ]] || die "bad manifest line: $line"
		NAMES+=("$n") SRCS+=("$REPO/$s") DSTS+=("${d/#\~/$HOME}") OSES+=("${o:-any}")
	done <"$MANIFEST"
}
trim() { local v="$1"; v="${v#"${v%%[![:space:]]*}"}"; printf '%s' "${v%"${v##*[![:space:]]}"}"; }

index_of() {
	local i
	for i in "${!NAMES[@]}"; do [[ "${NAMES[$i]}" == "$1" ]] && { echo "$i"; return 0; }; done
	return 1
}
applies_here() { [[ "${OSES[$1]}" == any || "${OSES[$1]}" == "$OS" ]]; }

# status of one entry: ok | missing | wrong | file | nosrc | n/a
state() {
	local i=$1 dst="${DSTS[$1]}" src="${SRCS[$1]}"
	applies_here "$i" || { echo "n/a"; return; }
	[[ -e "$src" || -L "$src" ]] || { echo "nosrc"; return; }
	if [[ -L "$dst" ]]; then
		[[ "$(readlink "$dst")" == "$src" ]] && echo ok || echo wrong
	elif [[ -e "$dst" ]]; then echo file
	else echo missing; fi
}

# selected indexes: given names, else every entry
select_indexes() {
	SEL=()
	if (($# == 0)); then
		local i; for i in "${!NAMES[@]}"; do SEL+=("$i"); done
	else
		local n idx
		for n in "$@"; do
			idx="$(index_of "$n")" || die "unknown config: $n (see: ithactl list)"
			SEL+=("$idx")
		done
	fi
}

# --- commands ---------------------------------------------------------------
cmd_list() {
	local quiet=0 i st col bad=0
	[[ "${1:-}" == "-q" ]] && quiet=1
	for i in "${!NAMES[@]}"; do
		st="$(state "$i")"
		case "$st" in
			ok) col=$G ;;
			n/a) col=$D ;;
			missing) col=$Y ;;
			*) col=$R ;;
		esac
		[[ "$st" != ok && "$st" != n/a ]] && bad=1
		((quiet)) && [[ "$st" == ok || "$st" == n/a ]] && continue
		printf '  %-14s %s%-8s%s %s\n' "${NAMES[$i]}" "$col" "$st" "$N" "${DSTS[$i]/#$HOME/~}"
	done
	if ((bad)); then
		info "${D}missing=not linked  wrong=link points elsewhere  file=real file in the way  nosrc=not in repo${N}"
		return 1
	fi
}

cmd_apply() {
	local mode=skip dry=0 names=() a
	for a in "$@"; do
		case "$a" in
			-b|--backup) mode=backup ;;
			-w|--overwrite) mode=overwrite ;;
			-n|--dry-run) dry=1 ;;
			-*) die "unknown option: $a" ;;
			*) names+=("$a") ;;
		esac
	done
	select_indexes ${names[@]+"${names[@]}"}
	local i st src dst n rc=0
	for i in "${SEL[@]}"; do
		n="${NAMES[$i]}" src="${SRCS[$i]}" dst="${DSTS[$i]}" st="$(state "$i")"
		case "$st" in
			ok) continue ;;
			n/a) ((${#names[@]})) && info "${D}skip $n (only for ${OSES[$i]})${N}"; continue ;;
			nosrc) info "${R}skip $n: source missing in repo${N}"; rc=1; continue ;;
			wrong|file)
				case "$mode" in
					skip) info "${Y}skip $n: $st at ${dst/#$HOME/~} (use -b or -w)${N}"; rc=1; continue ;;
					backup)
						info "backup $n: ${dst/#$HOME/~} -> ${dst/#$HOME/~}.backup-$TS"
						((dry)) || mv "$dst" "$dst.backup-$TS" ;;
					overwrite)
						info "remove $n: ${dst/#$HOME/~}"
						((dry)) || rm -rf "$dst" ;;
				esac ;;
		esac
		info "${G}link${N}   $n: ${dst/#$HOME/~} -> ${src/#$REPO\//}"
		((dry)) || { mkdir -p "$(dirname "$dst")" && ln -s "$src" "$dst"; }
	done
	return $rc
}

cmd_remove() {
	local yes=0 names=() a
	for a in "$@"; do
		case "$a" in
			-y|--yes) yes=1 ;;
			-*) die "unknown option: $a" ;;
			*) names+=("$a") ;;
		esac
	done
	select_indexes ${names[@]+"${names[@]}"}
	if ((${#names[@]} == 0 && !yes)); then
		read -r -p "Remove ALL managed symlinks? [y/N] " a </dev/tty || a=n
		[[ "$a" == y ]] || die "cancelled"
	fi
	local i
	for i in "${SEL[@]}"; do
		if [[ "$(state "$i")" == ok ]]; then
			rm "${DSTS[$i]}" && info "${G}removed${N} ${NAMES[$i]}"
		else
			((${#names[@]})) && info "${D}skip ${NAMES[$i]}: not a symlink into this repo${N}"
		fi
	done
}

cmd_adopt() {
	[[ $# -eq 1 ]] || die "usage: ithactl adopt NAME"
	local i src dst
	i="$(index_of "$1")" || die "unknown config: $1 (add it to links.conf first)"
	src="${SRCS[$i]}" dst="${DSTS[$i]}"
	[[ -L "$dst" ]] && die "$dst is already a symlink"
	[[ -e "$dst" ]] || die "nothing to adopt at $dst"
	[[ -e "$src" ]] && die "$src already exists in the repo; use: ithactl apply $1 -b"
	mkdir -p "$(dirname "$src")"
	mv "$dst" "$src" && ln -s "$src" "$dst"
	info "${G}adopted${N} $1: moved into ${src/#$REPO\//} and linked back"
	info "${D}review it for secrets before committing${N}"
}

# --- main -------------------------------------------------------------------
cmd="${1:-help}"
(($#)) && shift
case "$cmd" in
	help|-h|--help) usage ;;
	list|ls|status) load_manifest; cmd_list "$@" ;;
	apply|ap|all) load_manifest; cmd_apply "$@" ;;
	remove|rm) load_manifest; cmd_remove "$@" ;;
	adopt) load_manifest; cmd_adopt "$@" ;;
	*) usage >&2; exit 1 ;;
esac
